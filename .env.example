# 服务器监听配置
VOICE_SERVER_HOST=0.0.0.0
VOICE_SERVER_PORT=8000

# 百度 ASR，参数参考 ESP32-S3_Master/components/BSP/ASR/asr.c
BAIDU_ASR_API_KEY=your-baidu-asr-api-key
BAIDU_ASR_SECRET_KEY=your-baidu-asr-secret-key
BAIDU_ASR_CUID=esp32s3-ci1306-server
BAIDU_ASR_RATE=16000
BAIDU_ASR_FORMAT=pcm
BAIDU_ASR_DEV_PID=1537

# 百度 TTS，参数参考 ESP32-S3_Master/components/BSP/TTS/tts.c
BAIDU_TTS_API_KEY=your-baidu-tts-api-key
BAIDU_TTS_SECRET_KEY=your-baidu-tts-secret-key
BAIDU_TTS_PER=4146
BAIDU_TTS_AUE=3
BAIDU_TTS_SPEED=6
BAIDU_TTS_PITCH=5
BAIDU_TTS_VOLUME=5

# 火山方舟 LLM，参数参考 ESP32-S3_Master/components/BSP/LLM/llm.c
ARK_API_KEY=your-ark-api-key
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_MODEL=doubao-seed-2-0-mini-260428
ARK_THINKING_TYPE=disabled
ARK_MAX_TOKENS=300
ARK_TEMPERATURE=0.7

# LLM 提供方切换：ark（豆包/火山方舟）| qwen（千问）| deepseek
LLM_PROVIDER=qwen

# 千问（DashScope OpenAI 兼容）
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
QWEN_API_KEY=
QWEN_MODEL=qwen3.7-flash

# DeepSeek（OpenAI 兼容）
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
# 请求中已通过 thinking=disabled 关闭推理，max_tokens 全部用于正文
DEEPSEEK_MAX_TOKENS=1024

# 本地短期记忆：按 ESP32 上报的 device_sn 隔离，存放在服务器本机 SQLite 文件中
MEMORY_ENABLE=1
MEMORY_DB_PATH=data/voice_memory.sqlite3
MEMORY_MAX_RECENT_TURNS=4
MEMORY_MAX_STORED_TURNS=80

# 和风天气查询配置：API Key 只保存在服务器端，不会发送给 ESP32；GeoAPI 用于自动解析内置表之外的城市。
WEATHER_ENABLE=1
WEATHER_LLM_POLISH=1
WEATHER_DEFAULT_CITY=深圳
QWEATHER_API_HOST=https://your-qweather-api-host
QWEATHER_API_KEY=your-qweather-api-key
QWEATHER_GEO_ENABLE=1
QWEATHER_TIMEOUT_SEC=8

# 本地音乐播放配置：音乐文件放在服务器端 music 目录，ESP32 只接收 MP3 音频流。
MUSIC_ENABLE=1
MUSIC_DIR=music
MUSIC_CHUNK_BYTES=4096

# LLM 工具路由：关键词未命中时，让 LLM 判断是否需要调用天气或音乐工具。
TOOL_ROUTER_ENABLE=1
TOOL_ROUTER_TIMEOUT_SEC=4
TOOL_ROUTER_MIN_CONFIDENCE=0.65
TOOL_ROUTER_MUSIC_MIN_CONFIDENCE=0.75

# 实时双工语音路线：默认保持 cascade，硬件验收通过后才切换为 realtime。
VOICE_ROUTE=cascade
REALTIME_PROVIDER=doubao
DOUBAO_REALTIME_API_KEY=your-doubao-realtime-api-key
DOUBAO_REALTIME_URL=wss://openspeech.bytedance.com/api/v3/duplex/realtime/dialogue
DOUBAO_REALTIME_MODEL=1.2.6.1
DOUBAO_REALTIME_VOICE=zh_female_xiaohe_jupiter_bigtts
DOUBAO_REALTIME_ASR_FORMAT=pcm
DOUBAO_REALTIME_TTS_FORMAT=pcm_s16le
DOUBAO_REALTIME_SYSTEM_PROMPT=你的名字叫小梦，是深圳市创梦龙科技有限公司研发的智能机器人端到端实时语音助手。回答要自然口语化，普通问题优先一句话，最多两句话；用户要求背诵、讲故事或完整读出内容时要保证完整；用户要求唱歌、哼唱、来一首时，不要只唱一句，未指定歌名时直接唱一段原创短歌，指定现成歌曲时给很短的代表性片段后用原创内容续唱，总长度通常6到10句或80到160个中文字符；不要使用列表、换行或特殊符号。
DOUBAO_REALTIME_MEMORY_ENABLE=1
DOUBAO_REALTIME_MEMORY_DB_PATH=data/doubao_realtime_memory.sqlite3
DOUBAO_REALTIME_MEMORY_MAX_RECENT_TURNS=4
DOUBAO_REALTIME_MEMORY_MAX_STORED_TURNS=80
QWEN_REALTIME_API_KEY=your-dashscope-realtime-api-key
QWEN_REALTIME_URL=wss://dashscope.aliyuncs.com/api-ws/v1/realtime?model=qwen3.5-omni-flash-realtime
QWEN_REALTIME_MODEL=qwen3.5-omni-flash-realtime
QWEN_REALTIME_VOICE=Tina
QWEN_REALTIME_TRANSCRIPTION_MODEL=gummy-realtime-v1
QWEN_REALTIME_SYSTEM_PROMPT=你的名字叫小梦，是深圳市创梦龙科技有限公司研发的智能机器人端到端实时语音助手。回答要自然口语化，普通问题优先一句话，最多两句话；用户要求背诵、讲故事或完整读出内容时要保证完整；不要使用列表、换行或特殊符号。
# 千问实时首版固定为客户端定边界；配置成 server_vad 会被启动校验拒绝。
QWEN_REALTIME_TURN_MODE=push_to_talk
QWEN_REALTIME_WEB_SEARCH_ENABLE=0
QWEN_REALTIME_TAIL_SILENCE_MS=200
QWEN_REALTIME_MEMORY_ENABLE=0
QWEN_REALTIME_MEMORY_DB_PATH=data/qwen_realtime_memory.sqlite3
QWEN_REALTIME_MEMORY_MAX_RECENT_TURNS=4
QWEN_REALTIME_MEMORY_MAX_STORED_TURNS=80
REALTIME_CONNECT_TIMEOUT_SEC=12
REALTIME_FIRST_RESPONSE_TIMEOUT_SEC=15
# 首段实时音频已到达后，连续无音频且无完成事件时的强制回收秒数，防止供应商半截响应占住下一轮。
REALTIME_OUTPUT_IDLE_TIMEOUT_SEC=6
# 采音提交后如果没有任何转写/回复事件，提前结束本轮，避免纯等端点静音上限。
REALTIME_ENDPOINT_NO_EVENT_MAX_SEC=2
REALTIME_ENDPOINT_SILENCE_MAX_SEC=5
REALTIME_COMMAND_QUEUE_SIZE=512
REALTIME_PCM_BRIDGE_QUEUE_SIZE=512
REALTIME_PCM_BRIDGE_PUT_TIMEOUT_SEC=0.2
REALTIME_RESPONSE_DONE_GRACE_SEC=1.2
REALTIME_PCM_BRIDGE_CLOSE_TIMEOUT_SEC=60
REALTIME_OUTPUT_SAMPLE_RATE=24000
REALTIME_MP3_BITRATE=64k
